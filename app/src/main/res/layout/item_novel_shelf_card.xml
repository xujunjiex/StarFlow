<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:id="@+id/novel_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            android:contentDescription="@string/novel_cover_desc" />

        <ProgressBar
            android:id="@+id/novel_item_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone" />

        <TextView
            android:id="@+id/novel_item_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:padding="8dp"
            android:background="#88000000"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:clickable="true"
            android:text="✕"
            android:visibility="gone" />

        <TextView
            android:id="@+id/novel_item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:padding="4dp"
            android:background="#AA000000"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="@string/novel_file_lost"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/novel_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/novel_item_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />
</LinearLayout>
