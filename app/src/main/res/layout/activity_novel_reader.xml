<?xml version="1.0" encoding="utf-8"?>
<!--
  小说阅读器 chrome：**与 `activity_manga_reader.xml` 逐层对齐**（同一批 drawable、同一套
  尺寸与边距、同样的五个浮层）。改这里之前先看漫画那份 —— 两个阅读器必须长得一模一样，
  内容不同只体现在中间那层（那边是位图页，这边是文字页）。
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/novel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 翻页区（分页模式） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/novel_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- 连续滚动模式（一段一行，懒加载） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/novel_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- 顶部左侧返回按钮 -->
    <FrameLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_floating_btn_view"
        android:padding="10dp"
        android:clickable="true"
        android:contentDescription="@string/reader_back">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_reader_back"
            android:contentDescription="@string/reader_back"/>
    </FrameLayout>

    <!-- 顶部右侧菜单按钮 -->
    <FrameLayout
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_floating_btn_view"
        android:padding="10dp"
        android:clickable="true"
        android:contentDescription="@string/reader_tab_more">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_reader_more"
            app:tint="#FFFFFF"
            android:contentDescription="@string/reader_tab_more"/>
    </FrameLayout>

    <!-- 顶部中间：章名 + 章内页码（点击开目录）。
         漫画那格只有页码；小说多一个「第几章」——章节是小说最主要的定位单位，
         不放这里用户就没有任何常显的章节线索（这正是之前"章节功能没用"的来源）。

         ⚠️ **左右必须留出「碰不到两个圆钮」的硬边距**：以前这里是单个宽 `wrap_content` 的
         TextView，章名一长就横向长到 `btn_back` / `btn_menu` 底下（`第一回　宴桃园豪杰三结义
         斩黄巾英雄首立功` 这种回目一上来就压上了；网文那种 `[综英美]布鲁德海文小警察今天
         追星成功了吗` 更夸张）。圆钮是 40dp 宽 + 外侧 10dp，两边的 64dp 边距留下 14dp 间隙，
         章名再长也只会被省略号截断，不会钻到按钮下面。

         ⚠️ **章名与页码是两个 TextView**：塞进同一个字符串时省略号会把页码一起吃掉，
         而页码是这格存在的另一半理由。章名可省略（点上来看完整目录），页码永远完整。 -->
    <LinearLayout
        android:id="@+id/top_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_pill_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:clickable="true"
        android:contentDescription="@string/novel_toc">

        <!-- 章名。maxWidth 是给「页码不被挤掉」兜底的：15 个字（≈150dp @13sp）以内不截断，
             再长走省略号。行情上这一格可用宽 = 375dp - 64×2 = 247dp，
             章名 150 + 页码(含分隔号)≈50 + 内边距 24 = 224dp，还留 23dp 余量。 -->
        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="150dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>

        <!-- 章内页码 / 滚动进度。永远完整显示，不参与省略。 -->
        <TextView
            android:id="@+id/tv_page_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- 底部透明胶囊：上一章 / 章内进度 / 下一章。
         ⚠️ 左右两个按钮是**章**而不是页 —— 与 Koto 两个阅读器的 ReaderProgressBar 语义一致
         （那边也是 onPreviousChapter/onNextChapter）。页由左右点击区与滑动来翻。 -->
    <LinearLayout
        android:id="@+id/bottom_progress"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_progress_pill"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/novel_prev_chapter">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_prev"
                android:contentDescription="@string/novel_prev_chapter"/>
        </FrameLayout>

        <com.moe.starflow.mangaimport.reader.ReaderProgressBar
            android:id="@+id/novel_progress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="4dp"/>

        <FrameLayout
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/novel_next_chapter">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_next"
                android:contentDescription="@string/novel_next_chapter"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 右下角翻译浮层组：与漫画同款三钮（三态切换 / 失败感叹号 / 翻译·重翻）。
         小说没有 OCR，但「翻这一章 / 重翻 / 三态 / 失败原因」一套都在。 -->
    <LinearLayout
        android:id="@+id/translate_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/bg_reader_translate_group">

        <!-- 选择模式下的动作说明（「翻译 3 段」/「重翻 2 段」/「翻译+重翻 3 段」）。
             ⚠️ 必须**文字**说清三种语义：按钮只有两个图标（翻译 / 刷新），
             「重翻」和「翻译+重翻」用图标区分不出来。非选择模式下 GONE。 -->
        <TextView
            android:id="@+id/tv_translate_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="2dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 清除选中段的译文（长按多选后用）。⚠️ 只在**选中集里有译过的段**时才显示 ——
             清除是对选中集动手，与当前屏幕上有没有译文无关（判据见 NovelTranslateChrome.showClear）。
             放在动作说明右边、三态左边：破坏性操作离主翻译按钮远一点，少误触。
             图标复用 app 既有的删除图标（白 tint），不另画一个「差不多」的。 -->
        <FrameLayout
            android:id="@+id/btn_clear_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="@string/reader_clear_selection_desc">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_action_delete"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reader_clear_selection_desc"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_toggle_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="@string/reader_toggle_desc">
            <ImageView
                android:id="@+id/iv_toggle_translate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_display_bilingual"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reader_toggle_desc"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_fail_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="@string/reader_translate_failed_badge">
            <ImageView
                android:id="@+id/iv_fail_translate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_warn"
                app:tint="#FF8A80"
                android:contentDescription="@string/reader_translate_failed_badge"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/reader_tab_translate">
            <ImageView
                android:id="@+id/iv_translate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_translate"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reader_tab_translate"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 空章 / 文件丢失等状态提示（压在中间） -->
    <TextView
        android:id="@+id/novel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
