<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/novel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/novel_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/novel_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 顶部栏（中间格点击可淡出） -->
    <LinearLayout
        android:id="@+id/novel_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="#CC000000">

        <ImageView
            android:id="@+id/novel_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/ic_reader_back"
            android:contentDescription="@string/novel_back"
            android:clickable="true" />

        <TextView
            android:id="@+id/novel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="14sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/novel_toc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:text="@string/novel_toc" />
    </LinearLayout>

    <!-- 底部：进度条 + 页码 + 工具栏 -->
    <LinearLayout
        android:id="@+id/novel_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/novel_prev_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:text="‹" />

            <com.moe.starflow.mangaimport.reader.ReaderProgressBar
                android:id="@+id/novel_progress"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/novel_next_chapter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:text="›" />
        </LinearLayout>

        <TextView
            android:id="@+id/novel_page_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="#CCFFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/novel_tab_style"
                style="@style/NovelReaderTab"
                android:text="@string/novel_tab_style" />

            <TextView
                android:id="@+id/novel_tab_translate"
                style="@style/NovelReaderTab"
                android:text="@string/novel_tab_translate" />

            <TextView
                android:id="@+id/novel_tab_more"
                style="@style/NovelReaderTab"
                android:text="@string/novel_tab_more" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/novel_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
