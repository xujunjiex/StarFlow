<?xml version="1.0" encoding="utf-8"?>
<!--
  单个 LlamaCpp 模型行（内置 Hy-MT2 与用户导入的 GGUF 共用）。
  按钮**直接铺在卡片上**：一行等宽（weight=1），按状态显隐，最多同时出现 3 个，
  所以既不用「⋮ 菜单」也不会挤。
    内置已下载：[模型设置] [删除]
    内置未下载：[下载] [模型设置] [删除]
    下载中：    [暂停] [取消]
    暂停/未完成：[继续] [取消]
    导入的模型：[设为当前] [模型设置] [删除]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- 第一行：选中态 + 名称/元信息 + 角标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rowActive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 第二行：内置模型的下载状态 / 进度 -->
    <TextView
        android:id="@+id/rowStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/rowProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:visibility="gone" />

    <!-- 第三行：等宽按钮，直接铺在卡片上 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rowActivate"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/llamacpp_set_active"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowDownload"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/download"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowResume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/resume"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowPause"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/pause"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/cancel"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowParams"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/llamacpp_section_params"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/rowDelete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:text="@string/delete"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
