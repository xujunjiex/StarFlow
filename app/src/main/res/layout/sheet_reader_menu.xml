<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- 四图标 Tab：24dp 原版图标，不放大不压缩 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:id="@+id/tab_paging">
            <ImageView android:id="@+id/sel_tab_paging" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_reader_paging" android:contentDescription="@string/reader_tab_paging"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:id="@+id/tab_translate">
            <ImageView android:id="@+id/sel_tab_translate" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_reader_translate" android:contentDescription="@string/reader_tab_translate"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:id="@+id/tab_appearance">
            <ImageView android:id="@+id/sel_tab_appearance" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_reader_appearance" android:contentDescription="@string/reader_color_filter"/>
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:id="@+id/tab_more">
            <ImageView android:id="@+id/sel_tab_more" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_reader_more" android:contentDescription="@string/reader_tab_more"/>
        </FrameLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33000000"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ========== 翻页面板 ========== -->
        <ScrollView
            android:id="@+id/panel_paging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/tv_mode_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/reader_reading_mode" android:textSize="12sp" android:textColor="#888888"/>

                <LinearLayout android:id="@+id/seg_mode" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp">

                    <FrameLayout android:id="@+id/seg_mode_ltr" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_mode_ltr" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_reader_ltr" android:contentDescription="@string/reader_mode_ltr"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_mode_rtl" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_mode_rtl" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_reader_rtl" android:contentDescription="@string/reader_mode_rtl"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_mode_vertical" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_mode_vertical" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_reader_vertical" android:contentDescription="@string/reader_mode_vertical"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_mode_webtoon" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_mode_webtoon" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_gesture_vertical" android:contentDescription="@string/reader_mode_webtoon"/>
                    </FrameLayout>
                </LinearLayout>

                <TextView android:id="@+id/tv_animation_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/reader_animation" android:textSize="12sp" android:textColor="#888888"/>

                <LinearLayout android:id="@+id/seg_animation" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center">

                    <FrameLayout android:id="@+id/seg_anim_none" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_anim_none" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_anim_none" android:contentDescription="@string/reader_anim_none"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_anim_default" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_anim_default" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_anim_default" android:contentDescription="@string/reader_anim_default"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_anim_advanced" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_anim_advanced" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_anim_advanced" android:contentDescription="@string/reader_anim_advanced"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_anim_simulation" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_anim_simulation" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/ic_anim_simulation" android:contentDescription="@string/reader_anim_simulation"/>
                    </FrameLayout>
                </LinearLayout>

                <TextView android:id="@+id/tv_background_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/reader_background" android:textSize="12sp" android:textColor="#888888"/>

                <LinearLayout android:id="@+id/seg_background" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center">

                    <FrameLayout android:id="@+id/seg_bg_default" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_bg_default" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bg_default" android:contentDescription="@string/reader_bg_default"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_bg_light" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_bg_light" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bg_light" android:contentDescription="@string/reader_bg_light"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_bg_dark" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_bg_dark" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bg_dark" android:contentDescription="@string/reader_bg_dark"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_bg_white" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_bg_white" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bg_white" android:contentDescription="@string/reader_bg_white"/>
                    </FrameLayout>
                    <FrameLayout android:id="@+id/seg_bg_black" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                        android:gravity="center" android:clickable="true">
            <ImageView android:id="@+id/sel_seg_bg_black" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center" android:src="@drawable/ic_sel_circle" android:visibility="gone"/>
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/ic_bg_black" android:contentDescription="@string/reader_bg_black"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== 翻译面板 ========== -->
        <ScrollView
            android:id="@+id/panel_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="460dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:id="@+id/tv_translate_mode_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/reader_translate_mode_title" android:textSize="12sp" android:textColor="#888888"/>

                <RadioGroup android:id="@+id/seg_translate_mode"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="2dp">
                    <RadioButton android:id="@+id/translate_mode_manual" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/reader_translate_mode_manual" android:checked="true"
                        android:paddingTop="6dp" android:paddingBottom="6dp"/>
                    <RadioButton android:id="@+id/translate_mode_auto" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/reader_translate_mode_auto"
                        android:enabled="false" android:alpha="0.4"/>
                    <RadioButton android:id="@+id/translate_mode_incremental" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/reader_translate_mode_incremental"
                        android:enabled="false" android:alpha="0.4"/>
                </RadioGroup>

                <!-- 模型区：OCR/翻译模型 快速跳转 -->
                <LinearLayout android:id="@+id/btn_model_ocr" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:gravity="center_vertical" android:clickable="true">
                    <TextView android:id="@+id/tv_ocr_model_row" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="14sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="16sp" android:textColor="#BBBBBB"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>
                <LinearLayout android:id="@+id/btn_model_translate" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:gravity="center_vertical" android:clickable="true">
                    <TextView android:id="@+id/tv_translator_model_row" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="14sp" android:textColor="#333333"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="›" android:textSize="16sp" android:textColor="#BBBBBB"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>

                <!-- 语言区：源/目标语言选择（下拉弹窗） -->
                <LinearLayout android:id="@+id/btn_source_lang" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:gravity="center_vertical" android:clickable="true">
                    <TextView android:id="@+id/tv_source_lang_value" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="14sp" android:textColor="#333333"/>
                    <ImageView android:id="@+id/iv_source_spinner" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/spinnericon"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_target_lang" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:paddingTop="10dp" android:paddingBottom="10dp"
                    android:gravity="center_vertical" android:clickable="true">
                    <TextView android:id="@+id/tv_target_lang_value" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:textSize="14sp" android:textColor="#333333"/>
                    <ImageView android:id="@+id/iv_target_spinner" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/spinnericon"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>

                <TextView android:id="@+id/tv_translate_summary" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingTop="8dp" android:paddingBottom="2dp" android:textSize="13sp"/>

                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/translate_filter_row" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_translate_pages"
                    android:layout_width="match_parent" android:layout_height="200dp"
                    android:layout_marginTop="6dp" android:clipToPadding="false"/>
            </LinearLayout>
        </ScrollView>

        <!-- ========== 调色面板 ========== -->
        <ScrollView android:id="@+id/panel_appearance" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxHeight="400dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                <!-- 原图 vs 处理后 对比预览 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="8dp">

                    <FrameLayout android:layout_width="0dp" android:layout_height="150dp" android:layout_weight="1"
                        android:layout_marginEnd="4dp" android:background="@drawable/bg_preview_cell">
                        <ImageView android:id="@+id/iv_orig_preview" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="top|start" android:layout_margin="6dp" android:paddingStart="6dp" android:paddingEnd="6dp"
                            android:background="@drawable/bg_pill_dark" android:text="@string/reader_preview_original"
                            android:textSize="10sp" android:textColor="#FFFFFF"/>
                    </FrameLayout>

                    <FrameLayout android:layout_width="0dp" android:layout_height="150dp" android:layout_weight="1"
                        android:layout_marginStart="4dp" android:background="@drawable/bg_preview_cell">
                        <ImageView android:id="@+id/iv_proc_preview" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:scaleType="centerCrop"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="top|start" android:layout_margin="6dp" android:paddingStart="6dp" android:paddingEnd="6dp"
                            android:background="@drawable/bg_pill_dark" android:text="@string/reader_preview_result"
                            android:textSize="10sp" android:textColor="#FFFFFF"/>
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp" android:paddingTop="4dp">
                    <TextView android:id="@+id/tv_color_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/reader_color_filter" android:textSize="14sp" android:textStyle="bold" android:textColor="#333333"/>
                    <TextView android:id="@+id/btn_reset_color" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_reset" android:drawablePadding="3dp" android:padding="4dp"
                        android:text="@string/reader_reset" android:textSize="12sp" android:textColor="#55AEEA" android:clickable="true"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                    <TextView android:id="@+id/tv_color_inverted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/reader_color_inverted" android:textSize="14sp" android:textColor="#333333"/>
                    <Switch android:id="@+id/sw_invert" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                    <TextView android:id="@+id/tv_color_grayscale" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/reader_color_grayscale" android:textSize="14sp" android:textColor="#333333"/>
                    <Switch android:id="@+id/sw_grayscale" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
                    <TextView android:id="@+id/tv_color_book" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/reader_color_book" android:textSize="14sp" android:textColor="#333333"/>
                    <Switch android:id="@+id/sw_book" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tv_brightness_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/reader_brightness" android:textSize="13sp" android:textColor="#333333"/>
                        <TextView android:id="@+id/tv_brightness_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="12sp" android:textColor="#55AEEA"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/sb_brightness" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:min="-100" android:max="100" android:layout_marginTop="2dp"
                        android:thumbTint="#55AEEA" android:progressTint="#55AEEA" android:progressBackgroundTint="#55AEEA"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp">
                        <TextView android:id="@+id/tv_contrast_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/reader_contrast" android:textSize="13sp" android:textColor="#333333"/>
                        <TextView android:id="@+id/tv_contrast_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0%" android:textSize="12sp" android:textColor="#55AEEA"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/sb_contrast" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:min="-100" android:max="100" android:layout_marginTop="2dp"
                        android:thumbTint="#55AEEA" android:progressTint="#55AEEA" android:progressBackgroundTint="#55AEEA"/>
                    <TextView android:id="@+id/tv_color_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
                        android:text="@string/reader_color_hint" android:textSize="11sp" android:textColor="#BBBBBB"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ========== 更多面板 ========== -->
        <LinearLayout android:id="@+id/panel_more" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="4dp" android:visibility="gone">

            <LinearLayout android:id="@+id/btn_rotate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:clickable="true">
                <TextView android:id="@+id/tv_rotate_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reader_rotate" android:textSize="14sp" android:textColor="#333333"/>
                <TextView android:id="@+id/tv_rotate_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reader_rotate_portrait" android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                    <TextView android:id="@+id/tv_auto_turn_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reader_auto_turn" android:textSize="14sp" android:textColor="#333333"/>
                    <TextView android:id="@+id/tv_interval_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="5s" android:textSize="11sp" android:textColor="#888888"/>
                </LinearLayout>
                <Switch android:id="@+id/sw_auto_turn" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>
            <LinearLayout android:id="@+id/btn_download" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:clickable="true">
                <TextView android:id="@+id/tv_download_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reader_download" android:textSize="14sp" android:textColor="#333333"/>
                <TextView android:id="@+id/tv_download_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reader_download_original" android:textSize="12sp" android:textColor="#888888"/>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#11000000"/>
            <LinearLayout android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical" android:clickable="true">
                <TextView android:id="@+id/tv_settings_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/reader_settings" android:textSize="14sp" android:textColor="#333333"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="16sp" android:textColor="#BBBBBB"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>