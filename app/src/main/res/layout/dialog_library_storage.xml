<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/library_current_path" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/library_path" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:textIsSelectable="true" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/library_space" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:text="@string/library_space_unknown" android:textColor="@color/text_primary" />
    <RadioGroup android:id="@+id/library_location_choices"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginTop="14dp">
        <RadioButton android:id="@+id/library_default" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" />
        <RadioButton android:id="@+id/library_choose" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="8dp" />
    </RadioGroup>
    <TextView android:id="@+id/library_custom_path" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingStart="36dp" android:paddingBottom="8dp"
        android:textColor="@color/text_secondary" android:visibility="gone" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="4dp" android:text="@string/library_folder_help" android:textColor="@color/text_secondary" />
    <TextView android:id="@+id/library_retry" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center_vertical" android:text="@string/library_retry_save" android:textColor="@color/text_primary" />
</LinearLayout>
