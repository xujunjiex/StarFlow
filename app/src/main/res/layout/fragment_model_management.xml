<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ════════════════════════════════════════════════════════
             1. ML Kit（内置）
             ════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/mlkit_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_group_mlkit"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/ocr_group_selector"
            android:clickable="true"/>
        <TextView
            android:id="@+id/mlkit_group_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ocr_group_selected"
            android:textColor="@color/success"
            android:textSize="12sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/setting_shape"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_group_mlkit_desc"
                android:textSize="11sp"
                android:textColor="#888"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_built_in_label"
                    android:textSize="13sp"
                    android:textColor="@color/success"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ════════════════════════════════════════════════════════
             2. PP-OCRv6（small 内置 + medium 可下载）
             ════════════════════════════════════════════════════════ -->
        <TextView
            android:id="@+id/ppocrv6_group_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_group_ppocrv6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/ocr_group_selector"
            android:clickable="true"/>
        <TextView
            android:id="@+id/ppocrv6_group_selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ocr_group_selected"
            android:textColor="@color/success"
            android:textSize="12sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/setting_shape"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/model_group_ppocrv6_desc"
                android:textSize="11sp"
                android:textColor="#888"
                android:layout_marginBottom="8dp"/>

            <!-- small tier（内置） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="small"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/model_v6_small_inline_desc"
                        android:textSize="11sp"
                        android:textColor="#888"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/model_built_in_label"
                    android:textSize="13sp"
                    android:textColor="@color/success"
                    android:layout_marginEnd="8dp"/>

                <RadioButton
                    android:id="@+id/ppocrv6_tier_small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- 分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"/>

            <!-- medium tier（可选下载） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical">

