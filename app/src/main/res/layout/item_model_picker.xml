<?xml version="1.0" encoding="utf-8"?>
<!--
  模型多选弹窗的一行：模型名 + 勾选框。
  ⚠️ 行高固定 48dp —— 弹窗代码按这个值乘行数算列表高度，改这里要同步改
  OpenAIText.showFetchedModelsDialog 里的 rowHeightPx。
  勾选框 clickable=false：整行由 ListView 的 itemClick 处理，避免只有点到小方块才生效。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/picker_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/picker_item_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />
</LinearLayout>
