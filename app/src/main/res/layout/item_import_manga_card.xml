<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/import_manga_page"/>

            <!-- 多选选中遮罩 -->
            <View
                android:id="@+id/view_selection_dim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000"
                android:visibility="gone"/>

            <!-- 多选勾选圈（右上角） -->
            <ImageView
                android:id="@+id/iv_selection_check"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_check_circle_ring"
                android:padding="2dp"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"/>

            <!-- 已读徽章（左上角） -->
            <TextView
                android:id="@+id/tv_read_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_read_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/import_read_badge"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone"/>

            <!-- 文件丢失徽章（左上角，与已读互斥） -->
            <TextView
                android:id="@+id/tv_lost_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_lost_badge"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="@string/import_file_lost"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="gone"/>

            <!-- 导入进度遮罩（仅「导入中占位」显示）：图片位直接显示进度 + 取消 -->
            <FrameLayout
                android:id="@+id/import_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#B3000000"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_import_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <ProgressBar
                    android:id="@+id/pb_import"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_gravity="bottom"
                    android:max="100"/>

                <TextView
                    android:id="@+id/tv_import_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="2dp"
                    android:padding="6dp"
                    android:contentDescription="@string/import_task_cancel_desc"
                    android:text="@string/import_task_cancel"
                    android:textColor="@color/white"
                    android:textSize="13sp"/>

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:paddingBottom="0dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>

        <TextView
            android:id="@+id/tv_page_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>