<?xml version="1.0" encoding="utf-8"?>
<!--
  LlamaCpp 模型管理页。
  这里**不再重复**功能说明（首次进入有弹窗、底部留一个「功能说明」入口可随时再看）。
  文字颜色全部显式指定（@color/text_primary / text_tertiary）：深浅主题下都不会与卡片/页面底色融在一起。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- ========== 内置模型 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text="@string/llamacpp_group_builtin"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/builtinContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ========== 导入的模型 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingBottom="8dp"
            android:text="@string/llamacpp_group_imported"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/importedEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/llamacpp_empty_imported"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/importedContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ========== 添加模型（蓝色主操作胶囊，与项目其它主按钮一致） ========== -->
        <TextView
            android:id="@+id/btnAddModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_download"
            android:gravity="center"
            android:minHeight="44dp"
            android:text="@string/llamacpp_add_model"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/addHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/llamacpp_import_hint"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <!-- 功能说明入口（正文只在弹窗里，避免页面重复） -->
        <TextView
            android:id="@+id/btnIntroLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp"
            android:text="@string/llamacpp_view_intro"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <!-- 导入进度（导入期间显示；任务在应用级作用域，离开页面也会继续） -->
        <LinearLayout
            android:id="@+id/importProgressBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/dialog_background"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/importProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llamacpp_import_started"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/importProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="100" />

            <TextView
                android:id="@+id/btnCancelImport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_neutral"
                android:gravity="center"
                android:minHeight="32dp"
                android:minWidth="72dp"
                android:text="@string/cancel"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
