<?xml version="1.0" encoding="utf-8"?>
<!--
  翻译面板里的**章节卡片**（漫画）。

  用户口径（2026-09-27 第三轮）：
  - 「整个翻译面板的一级二级标题大小统一」→ 章标题 13sp（与面板其它一级标题一致，
    不再比筛选栏大）
  - 「章卡片两个按钮长度可以不同，**宽度要一样**」→ 两个按钮都是 `0dp + weight=1`
  - 「每个章节卡片外面有一个框，**pxx 行要在框里面**」→ 卡片自带 `chapter_children` 容器，
    展开的页行由适配器 inflate 进这里（**一个章 = 一个列表项**），所以它们在卡片的边框之内
  - 底色由 `CardBackdrop` 在绑定时按面板深浅贴（浅色=白底+细描边，深色=深灰块+亮描边）

  行结构：`[章标题][徽章][箭头]` → `[主按钮][次按钮]`（等宽）→ `[chapter_children 展开的 pxx 行]`
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_chapter_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tv_chapter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tv_chapter_expand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:textSize="18sp"/>
    </LinearLayout>

    <!-- 两个动作按钮：**等宽**（文案长短不同没关系，宽度必须一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/btn_chapter_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="#55AEEA"/>

        <TextView
            android:id="@+id/btn_chapter_secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:textColor="#CC5555"/>
    </LinearLayout>

    <!-- ⚠️ **展开出来的 pxx 行挂在这里**（在卡片的框里面，不是另起一个列表项）。
         用户强调过三次「pxx 行要在框里面」；之前把页行做成独立 item + 左侧竖线，
         视觉上仍是"另一张卡" —— 所以改成 **一个章 = 一个 item**，
         子行由 `ReaderPageStateAdapter.bindChildren()` inflate 进这个容器。 -->
    <LinearLayout
        android:id="@+id/chapter_children"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
</LinearLayout>
