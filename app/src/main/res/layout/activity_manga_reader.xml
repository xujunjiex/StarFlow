<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 翻页区（分页模式） -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Webtoon 连续滚动模式（竖列表，懒加载） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/webtoonList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

    <!-- 顶部左侧返回按钮 -->
    <FrameLayout
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="10dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_floating_btn_view"
        android:padding="10dp"
        android:clickable="true"
        android:contentDescription="@string/reader_back">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_reader_back"
            android:contentDescription="@string/reader_back"/>
    </FrameLayout>

    <!-- 顶部右侧菜单按钮 -->
    <FrameLayout
        android:id="@+id/btn_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_floating_btn_view"
        android:padding="10dp"
        android:clickable="true"
        android:contentDescription="@string/reader_tab_more">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_reader_more"
            app:tint="#FFFFFF"
            android:contentDescription="@string/reader_tab_more"/>
    </FrameLayout>

    <!-- 顶部中间页面指示 -->
    <TextView
        android:id="@+id/tv_page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_pill_dark"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"/>

    <!-- 底部透明胶囊进度条（左翻页 / 中间进度条 / 右翻页） -->
    <LinearLayout
        android:id="@+id/bottom_progress"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_progress_pill"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/reader_prev">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_prev"
                android:contentDescription="@string/reader_prev"/>
        </FrameLayout>

        <com.moe.starflow.mangaimport.reader.ReaderProgressBar
            android:id="@+id/reader_progress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="4dp"/>

        <FrameLayout
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/reader_next">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_next"
                android:contentDescription="@string/reader_next"/>
        </FrameLayout>
    </LinearLayout>

    <!-- 右下角翻译浮层组：翻译按钮 +（有翻译结果时出现）三态切换按钮，同一背景组件。
         翻译按钮成功态图标变「重翻」（ic_refresh），点击即重新翻译；三态按钮点按循环 译文/原文/原图，长按开详情。 -->
    <LinearLayout
        android:id="@+id/translate_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="62dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="6dp"
        android:background="@drawable/bg_reader_translate_group">

        <FrameLayout
            android:id="@+id/btn_toggle_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="@string/reader_toggle_desc">
            <ImageView
                android:id="@+id/iv_toggle_translate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_translate"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reader_toggle_desc"/>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_translate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:clickable="true"
            android:contentDescription="@string/reader_tab_translate">
            <ImageView
                android:id="@+id/iv_translate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_reader_translate"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reader_tab_translate"/>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>