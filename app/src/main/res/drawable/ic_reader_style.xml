<!--
  Material: text_format（「A + 下划线」＝排版/样式）。
  第三面板放的是字号、行距、段距、间距 —— 用漫画「调色」那个画笔图标语义完全对不上。

  ⚠️ 原图 glyph 只占 24 格里的 x[5,19] / y[4,19]（约 58%×62%），和另外三个顶层图标
  （`ic_reader_paging` 占到 ~83%×87%）摆在一起明显偏小。这里用 group 放大 1.4 倍
  （绕中心），把它拉到同一视觉尺寸 —— 直接改 path 数字容易算错，包一层更稳。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.4"
        android:scaleY="1.4">
        <path
            android:fillColor="#FF000000"
            android:pathData="M5,17v2h14v-2H5zM9.5,12.8h5l0.9,2.2h2.1L12.75,4h-1.5L6.5,15h2.1l0.9,-2.2zM12,5.98L13.87,11h-3.74L12,5.98z"/>
    </group>
</vector>
