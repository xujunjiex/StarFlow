<!--
  显示三态之一：**译文**。
  「文」= 已转成目标语言的文字（与「原文」的 A 一眼可分）。
  ⚠️ 不能再用翻译按钮那个「A + 文」并排字形 —— 两颗按钮在同一浮层组里并排，
  同形就是"图标重复"（用户当场指出来了）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 亠：点 + 横 -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,2.4l1.5,1.5 -1.5,1.5 -1.5,-1.5z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M6.6,7.2h10.8v2.1H6.6z" />
    <!-- 撇（左下） -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M10.9,10.8l2.1,0.8 -5.3,9.7 -2.1,-0.8z" />
    <!-- 捺（右下） -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12.6,11.3l2.1,-0.6 5.6,8.6 -2,1.3z" />
</vector>
